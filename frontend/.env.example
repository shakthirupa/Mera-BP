# Copy to .env and fill in.

# ANY PHONE (internet): public HTTPS URL — deploy backend (docker compose on VPS) or run scripts/public-tunnel.ps1
EXPO_PUBLIC_API_URL=https://your-public-api.example.com

# Same Wi‑Fi only: http://YOUR_PC_LAN_IP:8080  (ipconfig)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8080

# Google OAuth (from Google Cloud Console)
EXPO_PUBLIC_WEB_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_ANDROID_ID=your-android-client-id.apps.googleusercontent.com

# Optional: Expo dev server host when using USB/Wi‑Fi debugging
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.100
