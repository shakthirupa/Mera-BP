<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow HTTP to local network IPs for dev backend (Android 9+ blocks cleartext by default) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.0.0</domain>
        <domain includeSubdomains="false">10.219.43.178</domain>
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="false">192.168.1.0</domain>
    </domain-config>
</network-security-config>
